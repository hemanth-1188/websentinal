PORT=5000
NODE_ENV=development
JWT_SECRET=webshield_super_secret_jwt_key_2026_change_in_production
MONGODB_URI=mongodb://webshield_user:webshield_pass@mongodb:27017/webshield_db?authSource=admin
MONGO_USER=webshield_user
MONGO_PASSWORD=webshield_pass
MONGO_DB=webshield_db
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://localhost:3000

MAX_SCAN_DURATION=300
MAX_REQUESTS_PER_SCAN=100
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=10000
MAX_REDIRECTS=5

# Set to true in development to allow scanning demo-target container
ALLOW_LOCAL_DEMO_TARGET=true
DEMO_TARGET_HOST=demo-target:8080
